{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/brand/**",
              "components/core/**",
              "components/flow/**",
              "components/forms/**",
              "components/navigation/**",
              "components/terminal/**",
              "ui_kits/portfolio/**",
              "ui_kits/social/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Space Grotesk|Space Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Space Grotesk, Space Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|teal|neutral|solid)$/]",
        "message": "<Badge> tone must be one of 'accent' | 'teal' | 'neutral' | 'solid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BauhausShape'] > JSXAttribute > JSXIdentifier[name!=/^(?:shape|size|color|outline|style|key|ref|className|style|children)$/]",
        "message": "<BauhausShape> doesn't accept that prop. Declared props: shape, size, color, outline, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='BauhausShape'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|circle|triangle|bar)$/]",
        "message": "<BauhausShape> shape must be one of 'square' | 'circle' | 'triangle' | 'bar'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|disabled|icon|iconAfter|as|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, disabled, icon, iconAfter, as, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|teal)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'teal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|label|padding|children|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: variant, label, padding, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:hairline|hard|sunken|accent)$/]",
        "message": "<Card> variant must be one of 'hairline' | 'hard' | 'sunken' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|onChange|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: label, checked, onChange, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute > JSXIdentifier[name!=/^(?:accent|shape|style|key|ref|className|style|children)$/]",
        "message": "<Divider> doesn't accept that prop. Declared props: accent, shape, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Divider'] > JSXAttribute[name.name='shape'] > Literal[value!=/^(?:square|circle)$/]",
        "message": "<Divider> shape must be one of 'square' | 'circle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute > JSXIdentifier[name!=/^(?:tagline|columns|note|tone|style|key|ref|className|style|children)$/]",
        "message": "<Footer> doesn't accept that prop. Declared props: tagline, columns, note, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Footer'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<Footer> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|color|strokeSet|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, color, strokeSet, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|prefix|invalid|placeholder|value|onChange|wrapperStyle|style|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, prefix, invalid, placeholder, value, onChange, wrapperStyle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|variant|glow|style|key|ref|className|style|children)$/]",
        "message": "<Monogram> doesn't accept that prop. Declared props: size, variant, glow, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:light|dark|accent)$/]",
        "message": "<Monogram> variant must be one of 'light' | 'dark' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|activeItem|onNavigate|cta|tone|style|key|ref|className|style|children)$/]",
        "message": "<NavBar> doesn't accept that prop. Declared props: items, activeItem, onNavigate, cta, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavBar'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<NavBar> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NodeFlow'] > JSXAttribute > JSXIdentifier[name!=/^(?:nodes|orientation|accentLast|style|key|ref|className|style|children)$/]",
        "message": "<NodeFlow> doesn't accept that prop. Declared props: nodes, orientation, accentLast, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='NodeFlow'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:horizontal|vertical)$/]",
        "message": "<NodeFlow> orientation must be one of 'horizontal' | 'vertical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromptCursor'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|color|blink|style|key|ref|className|style|children)$/]",
        "message": "<PromptCursor> doesn't accept that prop. Declared props: size, color, blink, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScanlineSurface'] > JSXAttribute > JSXIdentifier[name!=/^(?:intensity|tone|as|className|children|style|key|ref|className|style|children)$/]",
        "message": "<ScanlineSurface> doesn't accept that prop. Declared props: intensity, tone, as, className, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScanlineSurface'] > JSXAttribute[name.name='intensity'] > Literal[value!=/^(?:subtle|normal|strong)$/]",
        "message": "<ScanlineSurface> intensity must be one of 'subtle' | 'normal' | 'strong'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScanlineSurface'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:deep|black|mid)$/]",
        "message": "<ScanlineSurface> tone must be one of 'deep' | 'black' | 'mid'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute > JSXIdentifier[name!=/^(?:command|title|lede|level|align|style|key|ref|className|style|children)$/]",
        "message": "<SectionHeading> doesn't accept that prop. Declared props: command, title, lede, level, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionHeading'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<SectionHeading> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Select'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|options|value|onChange|wrapperStyle|style|key|ref|className|style|children)$/]",
        "message": "<Select> doesn't accept that prop. Declared props: label, options, value, onChange, wrapperStyle, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|label|glow|size|style|key|ref|className|style|children)$/]",
        "message": "<StatusDot> doesn't accept that prop. Declared props: tone, label, glow, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatusDot'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ok|warn|idle)$/]",
        "message": "<StatusDot> tone must be one of 'ok' | 'warn' | 'idle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StepChain'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|activeIndex|style|key|ref|className|style|children)$/]",
        "message": "<StepChain> doesn't accept that prop. Declared props: steps, activeIndex, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Switch'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|onChange|label|disabled|style|key|ref|className|style|children)$/]",
        "message": "<Switch> doesn't accept that prop. Declared props: checked, onChange, label, disabled, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onRemove|children|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: active, onRemove, children, style."
      },
