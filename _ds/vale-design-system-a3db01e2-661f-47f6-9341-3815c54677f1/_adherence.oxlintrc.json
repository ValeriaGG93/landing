        "selector": "JSXOpeningElement[name.name='TerminalBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:lines|title|tone|style|key|ref|className|style|children)$/]",
        "message": "<TerminalBlock> doesn't accept that prop. Declared props: lines, title, tone, style."
