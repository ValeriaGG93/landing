        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|inverse|accent)$/]",
        "message": "<Wordmark> tone must be one of 'default' | 'inverse' | 'accent'."
      }
